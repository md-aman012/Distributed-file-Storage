# ─────────────────────────────────────────────────────────────
# Backend Environment Variables — TEMPLATE
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to Git.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development   # change to 'production' on Render

# PostgreSQL connection string (from Supabase / Render Postgres / etc.)
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>

# JWT — use a long, random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# AWS S3 credentials (IAM user with least-privilege S3 access)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=your-bucket-name

# CORS — set to your Vercel frontend URL in production
# e.g. https://distributed-file-storage.vercel.app
CORS_ORIGIN=
